PORT=3000
# Persistent disk path in production (e.g. /data/club.db). The directory is created if missing.
DB_FILE=./club.db
# REQUIRED when NODE_ENV=production (the server refuses to start without them, or with the demo placeholders).
# Organizer key: exchanged once at POST /api/admin/login for a JWT; organizer calls then send
# "Authorization: Bearer <token>". Rotating it signs every organizer out.
ORGANIZER_KEY=demo-organizer-key
# Secret that signs organizer session JWTs (HS256). Rotating it signs every organizer out.
JWT_SECRET=change-me-too
# Organizer session length in seconds (default 8 hours, 60 seconds to 7 days).
JWT_TTL_SEC=28800
# Secret used to sign pass tokens. Rotating it invalidates every issued pass.
PASS_SECRET=change-me-please
NODE_ENV=development
# Number of trusted reverse-proxy hops. "0"/"false"/unset = do not trust X-Forwarded-For. "1"/"true" = one proxy.
TRUST_PROXY=0
# Rate limits per IP per minute: public POSTs / all /api/admin/* calls / wrong organizer keys and bad tokens
RATE_LIMIT_PER_MIN=30
ADMIN_RATE_LIMIT_PER_MIN=120
AUTH_FAIL_LIMIT_PER_MIN=10
# Assistant questions per IP per minute (its own bucket, separate from registrations).
ASSISTANT_RATE_LIMIT_PER_MIN=20
# OPTIONAL AI helper for the public assistant. Leave these unset and the assistant still answers from the event data.
# Set both AI_API_KEY and AI_MODEL to turn it on. Any provider with an OpenAI-compatible "chat completions" endpoint
# works: point AI_BASE_URL at it. The key stays on the server; it is never sent to the browser. Never commit a real key.
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=8000
